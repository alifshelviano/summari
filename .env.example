# ==============================================================================
# SUMMARI ENVIRONMENT CONFIGURATION (TEMPLATE)
# Salin file ini menjadi .env.local untuk konfigurasi lokal:
# cp .env.example .env.local
# ==============================================================================

# 1. Google Gemini AI API Key (Dapatkan gratis di https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. SMTP Email Configuration (Untuk pengiriman email dengan lampiran PDF)
# Contoh menggunakan Gmail SMTP dengan Google App Password:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="Summari AI" <your_email@gmail.com>

# Catatan: Jika SMTP_HOST tidak diisi, sistem secara otomatis beralih ke
# sandbox Ethereal Email untuk pengujian tanpa perlu konfigurasi awal.
